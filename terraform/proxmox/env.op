# 1Password 参照のみを含む env ファイル（実値なし・コミット可）
# `op run --env-file=terraform/proxmox/env.op -- <command>` で実行時にのみ子プロセスへ注入される。
# 参照先 vault は既存の `K8s`。値の投入はユーザーが 1Password 上で手動で行う。
#
# 検証: `grep -vE 'op://|^#|^$' terraform/proxmox/env.op` が空であること（実値が無いこと）。

# --- 秘密値 ---
TF_VAR_proxmox_password=op://K8s/terraform-proxmox/password

# --- 個人情報 ---
TF_VAR_proxmox_endpoint=op://K8s/terraform-proxmox/endpoint
TF_VAR_control_plane_ip=op://K8s/terraform-proxmox/control_plane_ip
TF_VAR_worker_ips=op://K8s/terraform-proxmox/worker_ips
TF_VAR_gateway_ip=op://K8s/terraform-proxmox/gateway_ip
TF_VAR_worker_hdd_storage_by_id=op://K8s/terraform-proxmox/worker_hdd_storage_by_id
TF_VAR_worker_hdd_backup_by_id=op://K8s/terraform-proxmox/worker_hdd_backup_by_id

# --- SSH 公開鍵（cloud-init で VM に注入。非秘密だが個人に紐づくため op 参照） ---
# 秘密鍵は 1Password SSH Agent 経由で提供するため env.op には含めない（providers.tf を参照）。
TF_VAR_ssh_public_key=op://K8s/terraform-proxmox/ssh_public_key

# --- Cloudflare R2 バックエンド認証（AWS SDK 標準の環境変数） ---
AWS_ACCESS_KEY_ID=op://K8s/cloudflare-r2/access_key_id
AWS_SECRET_ACCESS_KEY=op://K8s/cloudflare-r2/secret_access_key
AWS_ENDPOINT_URL_S3=op://K8s/cloudflare-r2/endpoint
