# 1Password 参照のみを含む env ファイル（実値なし・コミット可）
# `op run --env-file=terraform/cloudflare/env.op -- <command>` で実行時にのみ子プロセスへ注入される。
# 参照先 vault は既存の `K8s`。値の投入はユーザーが 1Password 上で手動で行う。
#
# 検証: `grep -vE 'op://|^#|^$' terraform/cloudflare/env.op` が空であること（実値が無いこと）。

# --- 秘密値 ---
TF_VAR_cloudflare_dns_api_token=op://K8s/terraform-cloudflare/dns_api_token
TF_VAR_cloudflare_r2_api_token=op://K8s/terraform-cloudflare/r2_api_token

# --- 個人情報 ---
TF_VAR_cloudflare_account_id=op://K8s/terraform-cloudflare/account_id
TF_VAR_home_ip=op://K8s/terraform-cloudflare/home_ip
TF_VAR_sakura_mail_server=op://K8s/terraform-cloudflare/sakura_mail_server
TF_VAR_sakura_spf_txt=op://K8s/terraform-cloudflare/sakura_spf_txt
TF_VAR_sakura_dmarc_rua=op://K8s/terraform-cloudflare/sakura_dmarc_rua
TF_VAR_sakura_dkim_selector=op://K8s/terraform-cloudflare/sakura_dkim_selector
TF_VAR_sakura_dkim_txt=op://K8s/terraform-cloudflare/sakura_dkim_txt

# --- Cloudflare R2 バックエンド認証（AWS SDK 標準の環境変数） ---
AWS_ACCESS_KEY_ID=op://K8s/cloudflare-r2/access_key_id
AWS_SECRET_ACCESS_KEY=op://K8s/cloudflare-r2/secret_access_key
AWS_ENDPOINT_URL_S3=op://K8s/cloudflare-r2/endpoint
